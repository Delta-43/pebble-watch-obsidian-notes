# Copy to docker/.env and fill in real values. Never commit the real .env file.

# --- Vault mount (standalone path only) ---
# Absolute host directory of your Obsidian vault (however it got there — LiveSync, Syncthing, iCloud
# Drive, or Obsidian running right on this machine). Needs a pre-existing .obsidian/ folder — create
# once: mkdir -p "$VAULT_PATH/.obsidian"
VAULT_PATH=

# Vault name obsidian-mcp registers this vault under. Must match the "vault" field n8n's Create Note
# node sends (see ../n8n/workflows/delta-notes.json) — defaults to "notes" on both sides, only change
# this if you've edited the workflow to use a different vault id.
VAULT_NAME=notes

# --- n8n's existing Docker network ---
# mcp-obsidian joins this so n8n's MCP Client node can reach it. Every n8n install names this network
# differently (depends on your compose project name) — find yours with `docker network ls` (look for
# the one your n8n container is actually on), or more precisely:
# `docker inspect <your-n8n-container-name> --format '{{json .NetworkSettings.Networks}}'`
N8N_NETWORK_NAME=
